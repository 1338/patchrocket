<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ setup ? 'Set up dashboard access' : 'Sign in' }} · PatchRocket</title>
    <link rel="stylesheet" href="/dashboard.css">
    <link rel="stylesheet" href="/auth.css">
</head>
<body>
<main class="auth-shell">
    <div class="brand"><span class="brand-icon" aria-hidden="true">⌁</span>Patch<span>Rocket</span></div>
    <section class="panel">
        <header><h1>{{ setup ? 'Set up dashboard access' : 'Sign in' }}</h1></header>
        <div class="settings-content">
            {% if error %}<p class="notice" role="alert">{{ error }}</p>{% endif %}
            {% for message in app.flashes('error') %}<p class="notice" role="alert">{{ message }}</p>{% endfor %}
            {% if setup and not code_ready %}
                <p>Generate a one-time setup code on the PatchRocket host, then reload this page.</p>
                <p><code>php bin/console patchrocket:auth bootstrap</code></p>
            {% else %}
            <form class="settings-form" method="post" action="{{ path(setup ? 'auth_setup' : 'auth_login') }}">
                <input type="hidden" name="_token" value="{{ csrf_token(setup ? 'dashboard-setup' : 'dashboard-login') }}">
                {% if setup %}
                <label>One-time setup code<input type="password" name="code" autocomplete="off" required maxlength="40"></label>
                {% endif %}
                <label>Username<input name="username" value="{{ setup ? 'admin' : '' }}" maxlength="40" autocomplete="username" required autofocus></label>
                <label>Password<input type="password" name="password" maxlength="72" autocomplete="{{ setup ? 'new-password' : 'current-password' }}"{% if setup %} minlength="12"{% endif %} required></label>
                <button class="button">{{ setup ? 'Create administrator' : 'Sign in' }}</button>
            </form>
            {% endif %}
            {% if not setup and providers %}
            <div class="auth-provider-list" aria-label="Identity providers">
                {% for provider in providers %}
                <a class="button secondary" href="{{ path('auth_sso_begin', {provider:provider.alias}) }}">{{ types[provider.type] }} · {{ provider.alias }}</a>
                {% endfor %}
            </div>
            {% endif %}
        </div>
    </section>
</main>
</body>
</html>
