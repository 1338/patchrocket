{% extends 'settings/_layout.html.twig' %}
{% import 'settings/_forms.html.twig' as form %}
{% set section = 'discovery' %}

{% block title %}Service discovery{% endblock %}

{% block settings_content %}
{% if selected and selected.kind in ['jenkins', 'harbor', 'registry', 'argocd', 'vm', 'cluster'] %}
<section class="panel" id="configure">
    <header><h2>Connect {{ types[selected.kind] }}</h2><a href="{{ path('settings_discovery') }}">Cancel</a></header>
    <form class="settings-content settings-form" method="post" action="{{ path('settings_discovery_adopt') }}">
        {{ form.token('delivery-adopt') }}
        <input type="hidden" name="candidate" value="{{ selected.id }}">
        {% if selected.kind == 'argocd' %}
            <label>Kubernetes connection<select name="cluster" required>
                <option value="">Choose a cluster</option>
                {% for cluster in clusters %}
                    <option value="{{ cluster.id }}"{{ selected_cluster == cluster.id ? ' selected' : '' }}>{{ cluster.name }}</option>
                {% endfor %}
            </select></label>
            <label>Application namespace<input name="namespace" value="{{ selected_namespace }}" placeholder="argocd" required></label>
            {{ form.credential('reference', 'Managed read credential reference', '', vault_destinations, 'kubeconfig', false, 'Uses the cluster credential by default') }}
        {% elseif selected.kind == 'jenkins' %}
            <label>Jenkins base URL<input type="url" name="server" value="{{ selected.binding.target ?? (selected.endpoint starts with 'http://' or selected.endpoint starts with 'https://' ? selected.endpoint : 'https://' ~ selected.endpoint) }}" required></label>
            {{ form.credential('reference', 'Managed read credential reference', '', vault_destinations, 'jenkins', true) }}
        {% elseif selected.kind in ['harbor', 'registry'] %}
            <label>Registry host<input name="host" value="{{ selected.binding.target ?? selected.endpoint|replace({'https://':'','http://':''})|split('/')|first }}" required></label>
            {{ form.credential('reference', 'Managed pull credential reference', '', vault_destinations, 'registry', true) }}
        {% elseif selected.kind == 'vm' %}
            <label>SSH user and host<input name="endpoint" value="{{ selected.binding.target ?? ('scanner@' ~ selected.endpoint) }}" required></label>
            {{ form.credential('reference', 'Managed SSH credential reference', '', vault_destinations, 'ssh', true) }}
        {% else %}
            <label>Kubeconfig context<input name="endpoint" value="{{ selected.binding.target ?? '' }}" required></label>
            <label>Namespace<input name="namespace" value="default" required></label>
            {{ form.credential('reference', 'Managed Kubernetes credential reference', '', vault_destinations, 'kubeconfig', true) }}
        {% endif %}
        <div class="actions"><button class="button">Save connection</button></div>
    </form>
</section>
{% endif %}

<section class="panel">
    <header><h2>SSH and Kubernetes</h2><a href="{{ path('settings_connections') }}">Manage connections</a></header>
    {% for source in sources %}
        <div class="asset-row">
            <span class="anywhere"><strong>{{ source.name }}</strong><small>{{ source.kind == 'cluster' ? 'Kubernetes' : 'SSH' }}{% if source.data.result|default %} · {{ source.data.result }}{% elseif source.data.status|default %} · {{ source.data.status|capitalize }}{% endif %}</small></span>
            {% if source.data.credential|default %}
            <form method="post" action="{{ path('settings_discovery_queue') }}">
                {{ form.token('delivery-queue') }}<input type="hidden" name="connection" value="{{ source.id }}"><button class="button secondary">Discover services</button>
            </form>
            {% else %}
                <a class="button secondary" href="{{ path('settings_connections', {edit:source.id}) }}">Add credential</a>
            {% endif %}
        </div>
    {% else %}
        <p class="empty">Add a managed SSH or Kubernetes connection to discover its services.</p>
    {% endfor %}
</section>

<section class="panel">
    <header><h2>Cloud inventories</h2></header>
    <form class="settings-content settings-form" method="post" action="{{ path('settings_discovery_cloud') }}">
        {{ form.token('delivery-cloud') }}
        <label>Cloud provider<select name="provider" required><option value="azure">Azure</option><option value="aws">AWS</option><option value="gcp">Google Cloud</option></select></label>
        <label>Subscription, account, or project<input name="scope" placeholder="Azure subscription ID, AWS account ID or Google Cloud project ID" required></label>
        <label>AWS region<input name="region" placeholder="eu-west-1"></label>
        {{ form.credential('credential', 'Managed cloud credential reference', '', vault_destinations, 'json') }}
        <label class="check-filter"><input type="checkbox" name="use_worker_identity" value="1"> Use the worker’s cloud CLI identity when no reference is entered</label>
        <div><button class="button">Discover cloud resources</button></div>
    </form>
</section>

<section class="panel">
    <header><h2>Discovered candidates</h2><a href="{{ path('settings_integrations') }}">Delivery integrations</a></header>
    {% if candidates %}
    <div class="table-wrap"><table>
        <thead><tr><th>Service</th><th>Endpoint hint</th><th>Discovery sources</th><th>Connection</th></tr></thead>
        <tbody>
        {% for candidate in candidates %}
        <tr>
            <td><strong>{{ types[candidate.kind] }}</strong><small>{{ candidate.label }}</small>{% if candidate.evidence %}<small>{{ candidate.evidence }}</small>{% endif %}</td>
            <td class="anywhere"><code>{{ candidate.endpoint }}</code></td>
            <td>{% for source, observed in candidate.sources %}<small title="{{ observed }}">{{ source }}</small>{% endfor %}</td>
            <td>{% if candidate.binding %}<small>Saved as {{ candidate.binding.target }}</small>{% endif %}
                {% if candidate.kind in ['jenkins', 'harbor', 'registry', 'argocd', 'vm', 'cluster'] %}
                <a class="button secondary" href="{{ path('settings_discovery', {adopt:candidate.id}) }}#configure">{{ candidate.binding ? 'Edit connection' : 'Configure' }}</a>
                {% endif %}
            </td>
        </tr>
        {% endfor %}
        </tbody>
    </table></div>
    {% else %}
        <p class="empty">Run discovery on a managed connection or cloud scope to view its results.</p>
    {% endif %}
</section>
{% endblock %}
