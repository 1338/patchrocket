{% extends 'settings/_layout.html.twig' %}
{% import 'settings/_forms.html.twig' as form %}
{% set section = 'secrets' %}

{% block settings_content %}
<section class="panel">
    <header><h2>{{ editing ? 'Edit secrets manager' : 'Manager configuration' }}</h2></header>
    <div class="settings-content">
        <form class="settings-form manager-settings" method="post" action="{{ path('settings_update', {action:'secrets-manager'}) }}">
            {{ form.token('secrets-manager') }}
            {% if editing %}<input type="hidden" name="editing" value="1">{% endif %}
            <label>Manager alias<input name="name" required maxlength="32" pattern="[a-z0-9][a-z0-9\-]{0,31}" placeholder="staging-vault" value="{{ editing.name ?? '' }}"{% if editing %} readonly{% endif %}><small>Use lowercase letters, digits, and hyphens. The alias goes before the colon in a credential reference.</small></label>
            <label>Provider<select name="provider">{% for key, label in managerTypes %}<option value="{{ key }}"{% if editing.type|default == key %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></label>
            <label>Region, project or Vault mount<input name="scope" placeholder="Use the field for AWS, Google Cloud or Vault" value="{{ editing.scope ?? '' }}"></label>
            <label class="vault-field">Vault address<input type="url" name="address" maxlength="512" placeholder="https://vault.example.com:8200" value="{{ editing.address ?? '' }}"><small>Use HTTPS for remote servers. Leave blank to use the worker’s Vault settings.</small></label>
            <label class="vault-field">Vault token<input type="password" name="vault_token" autocomplete="new-password" maxlength="4096" placeholder="{{ editing.has_token|default ? 'Token saved' : '' }}"><small>{{ editing.has_token|default ? 'Leave blank to keep the token for this address.' : 'Required when you enter a Vault address.' }}</small></label>
            <label class="vault-field">Vault write token<input type="password" name="vault_writer_token" autocomplete="new-password" maxlength="4096" placeholder="{{ editing.has_writer_token|default ? 'Write token saved' : 'Optional separate token' }}"><small>Allow create access to the KV v2 data path under <code>patchrocket/dashboard/</code>. Leave blank to keep a saved write token or use the Vault token above.</small></label>
            {% if editing.has_writer_token|default %}
            <label class="vault-field check-filter"><input type="checkbox" name="clear_vault_writer" value="1"> Remove separate write token</label>
            {% endif %}
            <div class="actions"><button class="button">Save secrets manager</button>{% if editing %}<a href="{{ path('settings_secrets') }}">Cancel edit</a>{% endif %}</div>
        </form>
        {% for manager in managers %}
        <div class="asset-row"><span><strong>{{ manager.data.name }}</strong><small>{{ managerTypes[manager.data.type] ?? 'Ansible Vault' }}{% if manager.data.type != 'ansible-vault' %} · {{ manager.data.scope }}{% endif %}{% if manager.data.address|default %} · {{ manager.data.address }}{% endif %}</small>
            {% if manager.data.type == 'ansible-vault' %}
            <details><summary>Credential references</summary><ul>
                {% for bundle in manager.data.bundles %}<li><code>{{ manager.data.name }}:{{ bundle }}</code></li>{% endfor %}
            </ul></details>
            {% endif %}
            </span>
            <div class="actions">
                {% if managerTypes[manager.data.type] is defined %}<a class="button secondary" href="{{ path('settings_secrets', {edit_manager:manager.data.name}) }}">Edit</a>{% endif %}
                <form method="post" action="{{ path('settings_update', {action:'manager-remove'}) }}">{{ form.token('manager-remove') }}<input type="hidden" name="name" value="{{ manager.data.name }}"><button class="button secondary">Remove manager</button></form>
            </div>
        </div>
        {% endfor %}
        <form class="settings-form" method="post" action="{{ path('settings_update', {action:'manager-test'}) }}">
            {{ form.token('manager-test') }}<label>Managed reference<input name="reference" required placeholder="manager:secret"></label>
            <div><button class="button secondary">Test reference</button></div>
        </form>
    </div>
</section>

{% if vault_destinations %}
<section class="panel">
    <header><h2>Store a credential bundle</h2></header>
    <div class="settings-content settings-form">
        {{ form.credential('', 'Generated reference', '', vault_destinations, 'json') }}
    </div>
</section>
{% endif %}

<section class="panel">
    <header><h2>Import Ansible Vault</h2></header>
    <form class="settings-content settings-form" method="post" enctype="multipart/form-data" action="{{ path('settings_update', {action:'ansible-vault'}) }}">
        {{ form.token('ansible-vault') }}
        <label>Manager name<input name="name" required maxlength="32" placeholder="ansible-prod"></label>
        {{ form.credential('password_reference', 'Vault password reference', '', vault_destinations, 'ansible', true) }}
        <label>Encrypted YAML or JSON file<input type="file" name="file" required></label>
        <label>Field mappings for flat variables<textarea name="mapping" rows="3" placeholder="private_key=ansible_ssh_private_key&#10;known_hosts=ssh_known_hosts"></textarea></label>
        <small>Store the Vault password in an external credential bundle under <code>password</code>. Upload a whole-file Vault. Each named mapping becomes a credential, or use field mappings to expose a single <code>default</code> credential.</small>
        <div><button class="button">Import Vault</button></div>
    </form>
</section>

<p><a href="{{ path('settings_integrations') }}">Configure Jenkins, Harbor, and Argo CD credential references</a></p>
{% endblock %}
