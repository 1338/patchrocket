{% macro token(action) %}<input type="hidden" name="_token" value="{{ csrf_token('settings-' ~ action) }}">{% endmacro %}
{% macro credential(field, label, value, destinations, kind, required = false, placeholder = 'manager:secret') %}
<div class="credential-editor" data-credential-editor>
    <label>{{ label }}
        <input data-credential-reference{% if field %} name="{{ field }}"{% else %} readonly{% endif %} value="{{ value }}" placeholder="{{ placeholder }}"{% if required %} required{% endif %}>
    </label>
    {% if destinations %}
    <details data-vault-writer="{{ kind }}" data-endpoint="{{ path('settings_store_credential') }}" data-token="{{ csrf_token('settings-store-credential') }}" hidden>
        <summary>{{ field ? 'Store new credential in Vault KV' : 'Enter credential' }}</summary>
        <div class="credential-fields">
            <label>Vault KV manager<select data-vault-manager>
                {% if destinations|length > 1 %}<option value="">Choose a manager</option>{% endif %}
                {% for alias in destinations %}<option value="{{ alias }}">{{ alias }}</option>{% endfor %}
            </select></label>
            {% if kind in ['git', 'jenkins', 'registry'] %}
                <label>Username<input data-vault-key="username" autocomplete="off"></label>
                <label>{{ kind == 'registry' ? 'Pull token or password' : 'Access token' }}<input data-vault-key="token" type="password" autocomplete="new-password"></label>
            {% elseif kind == 'ssh' %}
                <label>SSH private key<textarea data-vault-key="private_key" rows="4" spellcheck="false" autocomplete="off"></textarea></label>
                <label>Pinned known_hosts entry<textarea data-vault-key="known_hosts" rows="2" spellcheck="false"></textarea></label>
            {% elseif kind == 'kubeconfig' %}
                <label>Inline kubeconfig<textarea data-vault-key="kubeconfig" rows="5" spellcheck="false" autocomplete="off"></textarea></label>
                <small>Include the context and inline TLS and authentication data.</small>
            {% elseif kind == 'openai' %}
                <label>API key<input data-vault-key="api_key" type="password" autocomplete="new-password"></label>
            {% elseif kind == 'identity' %}
                <label>Client secret<input data-vault-key="client_secret" type="password" autocomplete="new-password"></label>
            {% elseif kind == 'identity' %}
                <label>Client secret<input data-vault-key="client_secret" type="password" autocomplete="new-password"></label>
            {% elseif kind == 'ansible' %}
                <label>Ansible Vault password<input data-vault-key="password" type="password" autocomplete="new-password"></label>
            {% elseif kind == 'json' %}
                <label>JSON credential bundle<textarea data-vault-json rows="5" spellcheck="false" autocomplete="off"></textarea></label>
            {% endif %}
            <div><button type="button" class="button secondary" data-store-credential>Store in Vault KV</button></div>
        </div>
    </details>
    <small data-credential-status role="status"></small>
    {% endif %}
</div>
{% endmacro %}
{% macro selectAssets(assets, name, label, kinds, selected = '', optional = false) %}
<label>{{ label }}
<select name="{{ name }}"{% if not optional %} required{% endif %}>
    <option value="">{{ optional ? 'None' : 'Select an asset' }}</option>
    {% for entry in assets|filter(a => a.kind in kinds) %}
    <option value="{{ entry.id }}"{{ entry.id == selected ? ' selected' : '' }}>{{ entry.name }} · {{ entry.kind }} · {{ entry.id|slice(0, 7) }}</option>
    {% endfor %}
</select></label>
{% endmacro %}
