{% if sources %}
<div class="table-wrap"><table>
    <thead><tr><th>Repository</th><th>Revision</th><th>Chart and values</th></tr></thead>
    <tbody>{% for source in sources %}
    <tr>
        <td class="anywhere">{{ source.repository }}{% if source.ref %}<small>Values alias ${{ source.ref }}</small>{% endif %}</td>
        <td class="anywhere">{{ source.revision ?: 'Default' }}{% if source.synced_revision %}<small>Synced {{ source.synced_revision }}</small>{% endif %}</td>
        <td class="anywhere">{{ source.chart ?: source.path }}{% if source.release %}<small>Release {{ source.release }}</small>{% endif %}{% if source.image_tag %}<small>Declared image tag {{ source.image_tag }}</small>{% endif %}{% for file in source.values_files %}<small>{{ file }}</small>{% endfor %}</td>
    </tr>
    {% endfor %}</tbody>
</table></div>
{% endif %}
