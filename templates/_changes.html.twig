{% if changes %}
<div class="table-wrap">
<table>
    <thead><tr><th>Remediation</th><th>Strategy</th><th>Status</th><th>Created</th></tr></thead>
    <tbody>
    {% for change in changes %}
        <tr>
            <td><a class="primary-link" href="{{ path('change', {id:change.id}) }}">{{ change.data.title ?? change.data.finding.advisory ?? change.id|slice(0, 8) }}</a></td>
            <td>{{ {composer:'Composer upgrade', npm:'npm upgrade', 'docker-base':'Docker base update', 'iac-image':'Infrastructure image update', 'standalone-binary':'Standalone executable'}[change.strategy] }}</td>
            <td>{% include '_status.html.twig' with {status: change.display_status} only %}</td>
            <td><time datetime="{{ change.created_at }}">{{ change.created_at|date('M j, H:i', 'UTC') }} UTC</time></td>
        </tr>
    {% endfor %}
    </tbody>
</table>
</div>
{% else %}<p class="empty">Remediation attempts will appear here after you prepare a patch.</p>{% endif %}
