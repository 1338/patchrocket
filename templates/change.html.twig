{% extends 'base.html.twig' %}
{% block title %}{{ change.data.title ?? change.data.finding.advisory }} remediation{% endblock %}
{% block content %}
{% set binary = change.strategy == 'standalone-binary' %}
{% set iac = change.strategy == 'iac-image' %}
<a class="back" href="{{ path('changes') }}">Remediations</a>
<header class="page-head">
    <div><div class="kicker">{{ {composer:'Composer upgrade', npm:'npm upgrade', 'docker-base':'Docker base update', 'iac-image':'Infrastructure image update', 'standalone-binary':'Standalone executable'}[change.strategy] }}</div>
    <h1>{{ change.data.title ?? change.data.finding.advisory }}</h1><p>{% include '_status.html.twig' with {status: change.display_status} only %}</p></div>
    <div class="actions"><a class="button secondary" href="{{ path('change', {id:change.id}) }}">Refresh</a>
    {% if change.status == 'awaiting_approval' and dashboard_role == 'admin' %}
    <form method="post" action="{{ path('approve', {id:change.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('approve-' ~ change.id) }}"><button class="button">{{ binary ? 'Approve executable' : 'Approve verified patch' }}</button></form>
    {% endif %}
    </div>
</header>
<section class="panel">
    <header><h2>Remediation plan</h2>
    {% if binary %}<a href="{{ path('asset', {id:change.data.plan.binary}) }}">Executable asset</a>
    {% else %}<a href="{{ path('finding', {id:change.finding_id}) }}">Original finding</a>{% endif %}
    </header>
    <dl class="facts">
        {% if binary %}
        <div><dt>Installed path</dt><dd class="mono anywhere">{{ change.data.plan.profile.path }}</dd></div>
        <div><dt>Fixing commit</dt><dd class="mono anywhere">{{ change.data.plan.candidate }}</dd></div>
        <div><dt>Previous executable SHA-256</dt><dd class="mono anywhere">{{ change.data.plan.profile.digest }}</dd></div>
        {% else %}
        <div><dt>From</dt><dd class="mono anywhere">{{ change.data.plan.installed ?? change.data.plan.current }}</dd></div>
        <div><dt>To</dt><dd class="mono anywhere">{{ change.data.plan.fixed }}</dd></div>
        {% endif %}
        {% if iac %}
        <div><dt>Deployment target</dt><dd class="mono anywhere">{{ change.data.plan.namespace }}/{{ change.data.plan.deployment }}/{{ change.data.plan.container }}</dd></div>
        <div><dt>Manifest</dt><dd class="mono anywhere">{{ change.data.plan.file }}</dd></div>
        {% endif %}
        <div><dt>Source commit</dt><dd class="mono anywhere">{{ change.data.revision }}</dd></div>
        {% if change.data.patch_sha256 is defined %}<div><dt>Patch SHA-256</dt><dd class="mono anywhere">{{ change.data.patch_sha256 }}</dd></div>{% endif %}
        {% if change.data.lock_sha256 is defined %}<div><dt>Lockfile SHA-256</dt><dd class="mono anywhere">{{ change.data.lock_sha256 }}</dd></div>{% endif %}
        {% if binary %}<div><dt>Candidate executable SHA-256</dt><dd class="mono anywhere">{{ change.data.binary_sha256 ?? 'Awaiting build evidence' }}</dd></div>
        {% else %}<div><dt>Candidate image</dt><dd class="mono anywhere">{{ change.data.candidate_image ?? 'Awaiting build evidence' }}</dd></div>{% endif %}
    </dl>
    {% if binary and dashboard_role != 'viewer' and change.status in ['approved', 'deployed'] %}
    <div class="settings-content actions">
        <a class="button" href="{{ path('binary_download', {id:change.id}) }}">Download approved executable</a>
        {% if change.status == 'approved' %}<form method="post" action="{{ path('binary_verify', {id:change.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('verify-binary-' ~ change.id) }}">
            <button class="button secondary">Verify installation</button>
        </form>{% endif %}
    </div>
    {% endif %}
    {% if iac and dashboard_role != 'viewer' and change.status == 'approved' %}
    {% set context = change.data.plan.context %}
    {% set namespace = change.data.plan.namespace %}
    {% set clusters = connections|filter(c => c.kind == 'cluster' and c.data.target == context and c.data.credential|default and (c.data.all_namespaces|default or c.data.namespace == namespace)) %}
    {% if clusters %}
    <form class="settings-content settings-form" method="post" action="{{ path('verify_iac', {id:change.id}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('verify-iac-' ~ change.id) }}">
        <label>Kubernetes connection<select name="connection" required>
            {% for cluster in clusters %}<option value="{{ cluster.id }}">{{ cluster.name }}</option>{% endfor %}
        </select></label>
        <div><button class="button secondary">Verify rollout</button></div>
    </form>
    {% elseif dashboard_role == 'admin' %}
    <p class="empty"><a href="{{ path('settings_connections') }}">Add a managed Kubernetes connection</a> for <code>{{ namespace }}</code> to verify the rollout.</p>
    {% endif %}
    {% endif %}
</section>
{% if change.data.patch is defined and dashboard_role != 'viewer' %}
<section class="panel">
    <header><h2>Candidate patch</h2><a href="{{ path('patch', {id:change.id}) }}">Download patch</a></header>
    <pre class="diff"><code>{{ change.data.patch }}</code></pre>
</section>
{% endif %}
{% if not binary and change.status in ['awaiting_approval', 'approved', 'monitoring', 'deployed'] %}
<section class="panel">
    <header><h2>Verified pull request</h2></header>
    <div class="settings-content">
    <p>Publish the patch with its recorded checks, review the evidence, then approve and merge here. Deployment verification follows runtime observation.</p>
    {% if pull_request %}<p><a href="{{ pull_request.url }}" rel="noreferrer">Open pull request</a></p>{% endif %}
    {% if dashboard_role == 'admin' %}
    <form method="post" action="{{ path('change_pull_request', {id:change.id}) }}" class="settings-form">
        <input type="hidden" name="_token" value="{{ csrf_token('pull-request-' ~ change.id) }}">
        <label>Repository connection<select name="connection" required>
            <option value="">Choose a repository from Settings</option>
            {% for connection in connections %}{% if connection.kind == 'repository' and (not iac or (connection.data.canonical_url ?: connection.data.target) == change.data.source_url) %}<option value="{{ connection.id }}">{{ connection.name }}</option>{% endif %}{% endfor %}
        </select></label>
        <label>Base branch<input name="base" value="{{ change.data.base_branch ?? 'main' }}" required></label>
        <button class="button secondary" name="operation" value="publish">Publish verified PR</button>
        {% if pull_request and change.status in ['approved', 'monitoring', 'deployed'] %}<button class="button" name="operation" value="merge">Merge verified PR</button>{% endif %}
    </form>
    {% endif %}
    </div>
</section>
{% endif %}
{% if publication %}{% include '_release_tracking.html.twig' %}{% endif %}
<section class="panel">
    <header><h2>Execution timeline</h2></header>
    <ol class="timeline">
    {% for event in events %}
    <li class="event">
        <time datetime="{{ event.created_at }}">{{ event.created_at|date('H:i:s', 'UTC') }} UTC</time>
        {% if event.kind == 'transition' %}
            {% set event_status = binary ? {approved:'binary_approved', deployed:'binary_deployed'}[event.data.to] ?? event.data.to : event.data.to %}
            <div>{% include '_status.html.twig' with {status:event_status} only %}<p>{{ event.data.note }}</p></div>
        {% elseif event.kind in ['check', 'rollout_check'] %}
            <div><strong>{{ event.data.label }}</strong> <span class="status {{ event.data.passed ? 'passed' : 'failed' }}">{{ event.data.passed ? 'Passed' : 'Failed' }}</span>
            {% if event.data.round %}<small>Compatibility round {{ event.data.round }}</small>{% endif %}
            {% if event.data.log is defined %}<details><summary>Verification output</summary><pre>{{ event.data.log }}</pre></details>{% endif %}</div>
        {% elseif event.kind == 'independent' %}
            <div><strong>Independent verification</strong> <span class="status {{ event.data.passed ? 'passed' : 'failed' }}">{{ event.data.passed ? 'Passed' : 'Failed' }}</span></div>
        {% elseif event.kind == 'export' %}
            <div><strong>Verified pull request</strong><p><a href="{{ event.data.url }}" rel="noreferrer">{{ event.data.url }}</a></p></div>
        {% elseif event.kind == 'merge' %}
            <div><strong>Pull request merge</strong><p>{{ event.data.note }}</p></div>
        {% elseif event.kind == 'release_tracking' %}
            <div><strong>Release tracking</strong><p>{{ event.data.note }}</p></div>
        {% elseif event.kind == 'proposal' %}
            <div><strong>{{ event.data.provider == 'replay' ? 'Recorded fixture proposal' : 'AI compatibility proposal' }}</strong>
            <p>{{ event.data.provider }}{{ event.data.model|default('') ? ' · ' ~ event.data.model : '' }} · round {{ event.data.round }}</p>
            {% if event.data.note is defined %}<p>{{ event.data.note }}</p>{% endif %}</div>
        {% endif %}
    </li>
    {% endfor %}
    </ol>
</section>
{% endblock %}
