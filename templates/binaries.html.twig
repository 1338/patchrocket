{% extends 'base.html.twig' %}
{% block title %}Standalone executables{% endblock %}
{% block content %}
<header class="page-head"><h1>Standalone executables</h1></header>
{% if dashboard_role == 'admin' %}
<section class="panel">
    <header><h2>{{ edit ? 'Edit executable' : 'Register an executable' }}</h2><a href="{{ path('settings_connections') }}">Manage connections</a></header>
    <form class="settings-content settings-form" method="post" action="{{ path('binary_update', {action:'save'}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('binary-save') }}">
        <label>Linux host<select name="host"><option value="">PatchRocket host</option>
            {% for host in hosts %}
            <option value="{{ host.id }}"{{ host.id == edit.host|default ? ' selected' : '' }}{% if not host.data.credential|default %} disabled{% endif %}>{{ host.name }}{% if not host.data.credential|default %} · Add managed SSH credential{% endif %}</option>
            {% endfor %}
        </select></label>
        <label>Installed executable path<input name="path" value="{{ edit.path ?? '' }}" placeholder="/opt/myapp/bin/myapp" required></label>
        <label>Application repository<select name="repository" required>
            <option value="">Choose a repository</option>
            {% for source in repositories %}<option value="{{ source.id }}"{{ source.id == edit.repository|default ? ' selected' : '' }}>{{ source.name }}</option>{% endfor %}
        </select></label>
        <label>Installed source commit<input name="revision" value="{{ edit.revision ?? '' }}" placeholder="Full Git commit SHA" required></label>
        <label>Local builder image ID or digest<input name="builder" value="{{ edit.builder ?? '' }}" placeholder="sha256:…" required></label>
        <label>Output path<input name="output" value="{{ edit.output ?? '' }}" placeholder="dist/myapp" required></label>
        <label>Committed build script<input name="build" value="{{ edit.build ?? '' }}" placeholder="tools/build.sh" required></label>
        <label>Committed test script<input name="test" value="{{ edit.test ?? '' }}" placeholder="tools/test.sh" required></label>
        <small>The worker passes the output path as the first argument to both scripts and runs them without network access.</small>
        <div class="actions"><button class="button">Save executable</button>{% if edit %}<a href="{{ path('binaries') }}">Cancel edit</a>{% endif %}</div>
    </form>
</section>
{% endif %}
{% for binary in binaries %}
<section class="panel">
    <header><h2><a href="{{ path('asset', {id:binary.id}) }}">{{ binary.name }}</a></h2>{% if dashboard_role == 'admin' %}<a href="{{ path('binaries', {edit:binary.id}) }}">Edit</a>{% endif %}</header>
    <dl class="facts">
        <div><dt>Installed path</dt><dd class="mono anywhere">{{ binary.data.path }}</dd></div>
        {% set source = repositories[binary.data.repository] ?? null %}
        {% if source %}<div><dt>Source</dt><dd><a href="{{ path('asset', {id:source.id}) }}">{{ source.name }}</a></dd></div>{% endif %}
        <div><dt>Installed source commit</dt><dd class="mono anywhere">{{ binary.data.revision }}</dd></div>
        <div><dt>Installed SHA-256</dt><dd class="mono anywhere">{{ binary.data.digest }}</dd></div>
    </dl>
    {% if dashboard_role != 'viewer' %}
    <form class="settings-content settings-form" method="post" action="{{ path('binary_update', {action:'build'}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('binary-build') }}">
        <input type="hidden" name="binary" value="{{ binary.id }}">
        <label>Fixing commit<input name="candidate" placeholder="Full Git commit SHA" required></label>
        <div><button class="button">Queue verified build</button></div>
    </form>
    {% endif %}
</section>
{% endfor %}
{% endblock %}
