{% extends 'base.html.twig' %}
{% block title %}{{ finding.data.advisory }}{% endblock %}
{% block content %}
{% set preparation = dashboard_role == 'viewer' ? null : preparation %}
<a class="back" href="{{ path('findings') }}">Vulnerabilities</a>
<header class="page-head">
    <div><div class="kicker">{{ finding.source }} · {{ finding.active ? 'Detected' : 'Absent at last scan' }}</div><h1>{{ finding.data.advisory }}</h1><p>{{ finding.data.title }}</p></div>
    {% if preparation.strategy|default in ['composer','npm'] %}
    <form method="post" action="{{ path('prepare', {id:finding.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('prepare-' ~ finding.id) }}"><button class="button">Prepare patch</button></form>
    {% elseif preparation.strategy|default in ['docker-base', 'iac-image'] %}
    <a class="button" href="#prepare-patch">Prepare patch</a>
    {% endif %}
</header>
<p><a href="{{ path('findings', {advisory:finding.data.advisory, view:'assets'}) }}">See all assets affected by this advisory</a></p>
<section class="panel"><header><h2>Finding details</h2>{% if finding.data.url %}<a href="{{ finding.data.url }}" rel="noreferrer">Source advisory</a>{% endif %}</header>
<dl class="facts">
    <div><dt>Severity</dt><dd><span class="severity {{ finding.data.severity|lower }}">{{ finding.data.severity|lower|capitalize }}</span></dd></div>
    <div><dt>Affected asset</dt><dd><a class="anywhere" href="{{ path('asset', {id:finding.asset_id}) }}">{{ finding.asset_name }}</a></dd></div>
    <div><dt>Package</dt><dd class="mono">{{ finding.data.package }}</dd></div>
    <div><dt>Scanned version</dt><dd class="mono">{{ finding.data.version }}</dd></div>
    <div><dt>Fixed version</dt><dd class="mono">{{ finding.data.fixed ?: 'Unavailable' }}</dd></div>
    <div><dt>CVSS</dt><dd>{{ finding.data.cvss ?? 'Unavailable' }}</dd></div>
    <div><dt>Scan target</dt><dd class="anywhere">{{ finding.data.target }}</dd></div>
    <div><dt>Last detected</dt><dd>{{ finding.last_seen|date('M j, H:i', 'UTC') }} UTC</dd></div>
</dl></section>
{% include '_build_sources.html.twig' %}
{% if preparation.strategy|default in ['docker-base', 'iac-image'] %}
{% set iac = preparation.strategy == 'iac-image' %}
<section class="panel" id="prepare-patch">
    <header><h2>{{ iac ? 'Prepare an infrastructure image update' : 'Prepare a Docker base patch' }}</h2><a href="{{ path('asset', {id:preparation.repository.id}) }}">{{ preparation.repository.name }}</a></header>
    <div class="settings-content">
        {% if iac %}
        <p>Update the image for <code>{{ preparation.source.namespace }}/{{ preparation.source.deployment }}/{{ preparation.source.container }}</code> in <code>{{ preparation.source.file }}</code>. PatchRocket scans the pinned upstream image before approval.</p>
        {% else %}
        <p>Patch <code>{{ preparation.source.dockerfile }}</code> on the selected source branch.</p>
        {% if preparation.overlay %}
        <p>Replace the nginx binary overlay with the pinned unprivileged Alpine image. The worker builds the module, tests its nginx configuration, and rescans the candidate image.</p>
        {% else %}
        <p>Replace a base image in a static <code>FROM</code> instruction. A scan of the rebuilt image is required before deployment.</p>
        {% endif %}
        {% endif %}
        <form class="settings-form" method="post" action="{{ path('prepare', {id:finding.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('prepare-' ~ finding.id) }}">
            <label>Source branch<input name="base" value="main" maxlength="101" required></label>
            <label>Replacement image with digest<input name="fixed" value="{{ preparation.fixed ?? '' }}" placeholder="registry/image:tag@sha256:…" maxlength="512" required></label>
            {% if not preparation.overlay|default and not iac %}
            <label>Current base image<input name="current" placeholder="registry/image:tag" maxlength="512" required></label>
            {% endif %}
            <label>Managed Git credential reference<input name="credential" value="{{ preparation.connection.data.credential ?? '' }}" placeholder="manager:secret" maxlength="1057"><small>Enter a repository read credential or use the local checkout’s remote-tracking branch. {% if preparation.connection and dashboard_role == 'admin' %}<a href="{{ path('settings_connections', {edit:preparation.connection.id}) }}#connection-repository">Edit the repository connection</a>.{% endif %}</small></label>
            <div><button class="button">Queue patch</button></div>
        </form>
    </div>
</section>
{% elseif preparation.error|default %}
<p class="notice">{{ preparation.error }}</p>
{% endif %}
{% for source in source_findings %}
<p><a class="primary-link" href="{{ path('finding', {id:source.id}) }}">View matching source finding in {{ source.name }}</a></p>
{% endfor %}
{% for link in links|filter(l => l.kind in ['BUILT_FROM', 'ASSOCIATED_SOURCE'] and l.asset_kind == 'repository') %}
<p>Associated source repository <a class="primary-link" href="{{ path('asset', {id:link.id}) }}">{{ link.name }}</a></p>
{% endfor %}
<section class="panel"><header><h2>Remediation history</h2></header>{% include '_changes.html.twig' %}</section>
{% endblock %}
