{% if asset.data.build_sources|default %}
<section class="panel" id="build-source">
    <header><h2>Build source</h2></header>
    <p class="empty">Matched the observed image tag to a Jenkinsfile at that Git commit.</p>
    <div class="table-wrap"><table>
        <thead><tr><th>Source</th><th>Build files</th><th>Argo CD applications</th></tr></thead>
        <tbody>{% for context, source in asset.data.build_sources %}
        <tr>
            <td><a href="{{ path('asset', {id:source.repository}) }}">{{ source.repository_name ?? 'Source repository' }}</a><small class="mono anywhere">{{ source.revision }}</small><small>{{ context }}</small></td>
            <td class="mono anywhere">{{ source.dockerfile }}<small>{{ source.jenkinsfile }}</small></td>
            <td>{% for id, name in source.applications %}<div><a href="{{ path('asset', {id:id}) }}">{{ name }}</a></div>{% endfor %}</td>
        </tr>
        {% endfor %}</tbody>
    </table></div>
</section>
{% endif %}
