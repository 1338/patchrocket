{
    "name": "patchrocket/patchrocket",
    "description": "Evidence-driven infrastructure and dependency remediation",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "beta",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "ext-pdo": "*",
        "ext-sodium": "*",
        "composer/semver": "^3.4",
        "doctrine/doctrine-bundle": "^2.18",
        "firebase/php-jwt": "^7.2",
        "symfony/ai-ollama-platform": "^1.0@beta",
        "symfony/ai-open-ai-platform": "^1.0@beta",
        "symfony/console": "7.4.*",
        "symfony/doctrine-messenger": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/http-client": "7.4.*",
        "symfony/mcp-bundle": "^1.0@beta",
        "symfony/process": "7.4.*",
        "symfony/security-csrf": "7.4.*",
        "symfony/workflow": "7.4.*",
        "symfony/yaml": "7.4.*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "symfony/ai-codex-platform": "^1.0@beta",
        "symfony/stopwatch": "7.4.*"
    },
    "autoload": {"psr-4": {"App\\": "src/"}},
    "config": {"platform": {"php": "8.2.32"}, "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }}
}
