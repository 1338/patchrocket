{% extends 'base.html.twig' %}
{% block title %}Vulnerabilities{% endblock %}
{% block content %}
<header class="page-head"><div><h1>Vulnerabilities</h1><p>{% if restrictedAsset %}<a href="{{ path('asset', {id:asset}) }}">{{ restrictedAsset.name }}</a>{% else %}Review advisories, affected assets, and available fixes.{% endif %}</p></div></header>
{% set query = {asset:asset, advisory:advisory, severity:severity, history:history ? 1 : 0, fix:fix ? 1 : 0} %}
<nav class="actions" aria-label="Vulnerability view">
    <a class="button {{ view == 'findings' ? '' : 'secondary' }}" href="{{ path('findings', query) }}">Finding details</a>
    <a class="button {{ view == 'advisories' ? '' : 'secondary' }}" href="{{ path('findings', query|merge({view:'advisories', advisory:''})) }}">Group by advisory</a>
    {% if advisory %}<a class="button {{ view == 'assets' ? '' : 'secondary' }}" href="{{ path('findings', query|merge({view:'assets'})) }}">Affected assets</a>{% endif %}
</nav>
<form action="{{ path('findings') }}" method="get" class="filters">
    <input type="hidden" name="view" value="{{ view }}">
    <label>Advisory ID <input name="advisory" value="{{ advisory }}" placeholder="CVE or advisory ID"></label>
    {% if asset %}<input type="hidden" name="asset" value="{{ asset }}">{% endif %}
    <label for="severity">Severity</label>
    <select id="severity" name="severity">
        <option value="">All severities</option>
        {% for option in ['CRITICAL','HIGH','MEDIUM','LOW','UNKNOWN'] %}
        <option{{ severity == option ? ' selected' : '' }} value="{{ option }}">{{ option|lower|capitalize }}</option>
        {% endfor %}
    </select>
    <label class="check-filter"><input type="checkbox" name="history" value="1"{{ history ? ' checked' : '' }}> Include scan history</label>
    <label class="check-filter"><input type="checkbox" name="fix" value="1"{{ fix ? ' checked' : '' }}> Fix available</label>
    <button class="button secondary">Apply filters</button>
</form>
<section class="panel">
{% if view in ['advisories','assets'] and findings %}
<div class="table-wrap"><table>
<thead><tr><th>{{ view == 'advisories' ? 'Advisory' : 'Affected asset' }}</th><th>Highest severity</th>{% if view == 'advisories' %}<th>Affected assets</th>{% endif %}<th>Findings</th><th>Fix available</th></tr></thead>
<tbody>
{% for row in findings %}
{% set severityLabel = ['Critical','High','Medium','Low','Unknown'][row.severity_rank] %}
<tr>
{% if view == 'advisories' %}
    <td><a class="primary-link" href="{{ path('findings', query|merge({advisory:row.advisory, view:'assets'})) }}">{{ row.advisory }}</a></td>
{% else %}
    <td><a class="primary-link" href="{{ path('asset', {id:row.asset_id}) }}">{{ row.asset_name }}</a><small>{{ row.asset_kind|capitalize }}{% if row.has_build_source %} · <a href="{{ path('asset', {id:row.asset_id}) }}#build-source">Build source</a>{% endif %}</small></td>
{% endif %}
<td><span class="severity {{ severityLabel|lower }}">{{ severityLabel }}</span></td>
{% if view == 'advisories' %}<td>{{ row.asset_count }}</td><td>{{ row.finding_count }}</td>
{% else %}<td><a href="{{ path('findings', query|merge({asset:row.asset_id})) }}">{{ row.finding_count }} findings</a></td>{% endif %}
<td>{{ row.fix_count }}</td></tr>
{% endfor %}
</tbody></table></div>
{% else %}{% include '_findings.html.twig' %}{% endif %}
</section>
{% if page > 1 or next %}
{% set query = query|merge({view:view}) %}
<nav class="actions" aria-label="Findings pages">
    {% if page > 1 %}<a class="button secondary" href="{{ path('findings', query|merge({page: page - 1})) }}">Previous page</a>{% endif %}
    <span>Page {{ page }}</span>
    {% if next %}<a class="button secondary" href="{{ path('findings', query|merge({page: page + 1})) }}">Next page</a>{% endif %}
</nav>
{% endif %}
{% endblock %}
