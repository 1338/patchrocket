{% for repo, definition in asset.data.declarations|default([]) %}
<section class="panel">
    <header><h2>GitOps declaration</h2><a href="{{ path('asset', {id:repo}) }}">Infrastructure repository</a></header>
    <p class="empty"><span class="mono anywhere">{{ definition.file }} · {{ definition.infra_revision }}</span>{% if definition.destination %}<br>Destination {{ definition.destination }} · {{ definition.cluster }}{% endif %}</p>
    {% include '_argo_sources.html.twig' with {sources:definition.sources} only %}
</section>
{% endfor %}
{% if asset.data.observation is defined and asset.data.observation is not null %}
{% set observation = asset.data.observation %}
<section class="panel">
    <header><h2>Argo CD observation</h2></header>
    <p class="empty">{{ asset.data.context }} / {{ asset.data.namespace }} · {{ observation.observed_at|date('M j, H:i', 'UTC') }} UTC<br>
    Sync {{ observation.sync ?: 'Unknown' }} · Health {{ observation.health ?: 'Unknown' }}{% if observation.destination %} · Destination {{ observation.destination }}{% endif %}</p>
    {% include '_argo_sources.html.twig' with {sources:observation.sources} only %}
</section>
{% endif %}
