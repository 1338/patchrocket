APP_ENV=dev
APP_DEBUG=0
DATABASE_URL=sqlite:///%kernel.project_dir%/var/patchrocket.db
DASHBOARD_TRUSTED_HOSTS='^localhost$,^127\.0\.0\.1$,^\[::1\]$'
DASHBOARD_TRUSTED_PROXIES=
AI_PROVIDER=off
AI_MODEL=
AI_OLLAMA_URL=http://127.0.0.1:11434
AI_OPENAI_KEY=
AI_ALLOW_CLOUD_SOURCE=false
AI_MAX_ATTEMPTS=2
WORKER_IMAGE=patchrocket-worker:local
WORKER_RESOLVER_NETWORK=none
TRIVY_BINARY=trivy
